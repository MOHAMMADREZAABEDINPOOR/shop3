# ===== نمونه تنظیمات محیطی — کپی به .env و مقادیر واقعی را بگذارید =====
# هرگز فایل .env را در گیت کامیت نکنید!

APP_NAME="نکست‌شاپ"
APP_TAGLINE="خرید آنلاین با تجربه‌ای متفاوت"
APP_URL="http://localhost:8000"

# روی هاست حتماً false شود
APP_DEBUG=true

# کلید رمزنگاری (۳۲ بایت base64) — با دستور زیر بسازید و اینجا بگذارید:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# دیتابیس: sqlite (پیش‌فرض) یا mysql
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nextshop
DB_USER=root
DB_PASS=

# نشست: ثانیه ماندگاری عادی، وقفه بیکاری، روزهای «مرا به خاطر بسپار»
SESSION_LIFETIME=43200
SESSION_IDLE_TIMEOUT=2700
SESSION_REMEMBER_DAYS=30

# روی هاست با HTTPS حتماً true شود
FORCE_HTTPS=false

# اطلاعات تماس واقعی فروشگاه
CONTACT_PHONE="021-91000000"
CONTACT_EMAIL="info@nextshop.ir"
CONTACT_ADDRESS="تهران، خیابان ولیعصر، برج نکست، طبقه ۳"
CONTACT_HOURS="شنبه تا پنجشنبه، ۹ تا ۲۱"

# گوگل آنالیتیکس (GA4). خالی = غیرفعال
GA_ID=
